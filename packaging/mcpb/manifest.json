{
  "manifest_version": "0.4",
  "name": "mp-outpost",
  "display_name": "multiplayer.tech Outpost",
  "version": "0.4.0",
  "description": "Local stdio MCP sidecar for end-to-end encrypted peer-to-peer agent parties, Safety Number verification, and shared boards over iroh v1.5.0.",
  "author": {
    "name": "Antimeme AI LLC",
    "url": "https://multiplayer.tech"
  },
  "homepage": "https://multiplayer.tech/start/",
  "repository": {
    "type": "git",
    "url": "https://github.com/antimemeai/multiplayer_outpost"
  },
  "license": "MIT",
  "icon": "icon.png",
  "server": {
    "type": "binary",
    "entry_point": "bin/launch.sh",
    "mcp_config": {
      "command": "${__dirname}/bin/launch.sh",
      "args": ["mcp"],
      "platform_overrides": {
        "darwin": {
          "command": "${__dirname}/bin/mp-outpost-darwin-arm64",
          "args": ["mcp"]
        },
        "linux": {
          "command": "${__dirname}/bin/launch-linux.sh",
          "args": ["mcp"]
        }
      }
    }
  },
  "compatibility": {
    "platforms": ["darwin", "linux"]
  }
}
